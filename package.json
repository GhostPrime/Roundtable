{
  "name": "roundtable",
  "version": "0.2.0",
  "description": "Roundtable - a local + online multi-AI chat app",
  "main": "electron/main.js",
  "author": "Phil Guadagna (GhostPrime)",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev:vite": "vite",
    "dev": "concurrently -k \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:electron": "wait-on tcp:5173 && electron . --dev",
    "build": "vite build",
    "test": "npm run test:prompts && npm run test:poll && npm run test:checks && npm run test:claims && npm run test:memory && npm run test:export && npm run test:jail && npm run test:ollama && npm run test:errors && npm run test:runtimes && npm run test:holdout",
    "test:prompts": "node --experimental-default-type=module scripts/check-prompt-regression.js",
    "test:poll": "node --experimental-default-type=module scripts/check-poll.js",
    "test:checks": "node --experimental-default-type=module scripts/check-parse-checks.js",
    "test:claims": "node --experimental-default-type=module scripts/check-claims.js",
    "test:memory": "node --experimental-default-type=module scripts/check-memory-graph.js",
    "test:export": "node --experimental-default-type=module scripts/check-session-html.js",
    "test:jail": "node scripts/check-write-jail.js",
    "test:ollama": "node scripts/check-ollama-thinking.js",
    "test:errors": "node --experimental-default-type=module scripts/check-error-message.js",
    "test:runtimes": "node scripts/check-runtimes.js",
    "test:holdout": "node --experimental-default-type=module scripts/check-memory-holdout.js",
    "start": "npm run build && cross-env NODE_ENV=production electron .",
    "preview": "vite preview",
    "dist": "npm run build && node scripts/build-version.js --win",
    "dist:mac": "npm run build && node scripts/build-version.js --mac",
    "pack": "npm run build && electron-builder --win --dir"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "imapflow": "^1.4.7",
    "mailparser": "^3.9.14",
    "monaco-editor": "^0.56.0",
    "nodemailer": "^9.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "vite": "^8.1.5",
    "wait-on": "^7.2.0"
  }
}
