{
  "name": "roundtable",
  "version": "0.1.0",
  "description": "Roundtable - a local + online multi-AI chat app",
  "main": "electron/main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev:vite": "vite",
    "dev": "concurrently -k \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:electron": "wait-on tcp:5173 && electron . --dev",
    "build": "vite build",
    "test": "npm run test:prompts",
    "test:prompts": "node --experimental-default-type=module scripts/check-prompt-regression.js",
    "start": "npm run build && cross-env NODE_ENV=production electron .",
    "preview": "vite preview",
    "dist": "npm run build && node scripts/build-version.js --win",
    "dist:mac": "npm run build && node scripts/build-version.js --mac",
    "pack": "npm run build && electron-builder --win --dir"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "vite": "^5.3.1",
    "wait-on": "^7.2.0"
  }
}
